# PostgreSQL（Coze 平台自动注入，本地开发可自行填写）
DATABASE_URL=postgresql://user:password@localhost:5432/qihang

# 对象存储（Coze 平台自动注入；成果库成片上传到 works/gallery/*.mp4）
# 填好后执行：npm run upload:works
COZE_STORAGE_URL=
COZE_STORAGE_BUCKET=
COZE_STORAGE_AK=
COZE_STORAGE_SK=

# 大模型（自定义，在 Coze 环境变量中配置）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 会话签名（生产请更换）
AUTH_SECRET=qihang-demo-secret-change-me

# 应用
PORT=3000

# 成果库成片目录（可选）。默认顺序：public/works/gallery → 本变量 → 上级 4视频/
# WORKS_VIDEO_DIR=G:/path/to/4视频
